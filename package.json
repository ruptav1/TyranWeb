{
  "name": "tyranweb",
  "productName": "TyranWeb",
  "version": "1.1.4",
  "description": "Trình duyệt web chủ đề anime 2000–2010, UI clean và tùy biến tự do.",
  "main": "src/main/main.js",
  "author": "TyranWeb",
  "license": "AGPL-3.0-only",
  "private": true,
  "updates": {
    "github": "ruptav1/TyranWeb"
  },
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "wallpapers": "electron scripts/optimize-wallpapers.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "app.tyranweb.browser",
    "productName": "TyranWeb",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/wallpapers/_raw/**",
      "!assets/wallpapers/_picks.json",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraFiles": [
      {
        "from": "docs/README-share.txt",
        "to": "README.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ]
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.1",
    "gsap": "3.13.0"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "@ghostery/adblocker": "2.20.1",
    "@ghostery/adblocker-content": "2.20.1",
    "@ghostery/adblocker-electron-preload": "2.20.1",
    "@ghostery/adblocker-extended-selectors": "2.20.1",
    "tldts-experimental": "7.4.18",
    "tldts-core": "7.4.18"
  }
}
